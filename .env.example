# ─── Database ────────────────────────────────────────────────
# Pilih SALAH SATU cara koneksi:
#
# (A) Managed Postgres (Neon/Supabase) — pakai satu connection string + SSL.
#     Kalau DATABASE_URL diisi, ia menang atas DB_HOST/DB_NAME/dst di bawah.
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/dbname?sslmode=require
DB_SSL=true
#
# (B) Lokal — isi field terpisah, DATABASE_URL & DB_SSL dikosongkan.
DB_NAME=sigitestore
DB_USER=postgres
DB_PASS=root
DB_HOST=localhost
DB_PORT=5432

# ─── App ─────────────────────────────────────────────────────
NODE_ENV=production
# PORT di-inject otomatis oleh Render; kosongkan saat deploy (kode fallback 3000 lokal).
PORT=5000
# Daftar origin FE yang diizinkan, dipisah koma (mis. URL Vercel).
ALLOWED_CORS=https://your-app.vercel.app
URL_BE=https://your-be.onrender.com
URL_FE=https://your-app.vercel.app

# ─── Auth ────────────────────────────────────────────────────
JWT_SECRET=change_me
AUTH_CLIENT_ID=your_google_oauth_client_id
AUTH_CLIENT_SECRET=your_google_oauth_client_secret

# ─── Xendit ──────────────────────────────────────────────────
XENDIT_PUBLIC_KEY=
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=

# ─── Digiflazz ───────────────────────────────────────────────
DIGIFLAZZ_USERNAME=
DIGIFLAZZ_API=
DIGIFLAZZ_KEY=
